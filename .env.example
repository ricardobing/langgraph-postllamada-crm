# Tu clave de OpenAI. Cópiala aquí y NO la subas al repo.
OPENAI_API_KEY=
# Modelo de OpenAI que usará tu código. Elige el que quieras y explica por qué en el README.
MODELO=gpt-5.6-luna

# --- Opcional -----------------------------------------------------------------------------------------------------
# Respaldo si el modelo principal falla o no está habilitado en la cuenta (por defecto gpt-6-luna; vacío = ninguno).
# MODELO_RESPALDO=gpt-6-luna

# Jev (TypeSafe) como añadido, apagado por defecto. Necesita una clave de OpenRouter. Ver docs/jev.md.
# JEV_ACTIVADO=1
# OPENROUTER_API_KEY=
# JEV_MODO=segunda_opinion   # o: rapido
